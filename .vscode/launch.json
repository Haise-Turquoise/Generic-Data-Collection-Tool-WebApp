    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-node",
            "request": "launch",
            "name": "Debug Backend",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\gdct-app\\backend\\src\\index.ts",
            "preLaunchTask": "tsc: build - gdct-app/backend/tsconfig.json",
            "outFiles": [
                "${workspaceFolder}/**/backend/dist/**/*.js"
            ],
            "envFile": "${workspaceFolder}\\gdct-app\\backend\\.env"
        }
    ]
}